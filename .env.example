ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=qwen/qwen3.7-flash
# Automatic difficulty routing. The router inspects text and locally extracted MediaPipe observations.
ORCAROUTER_ROUTER_MODEL=qwen/qwen3.7-flash
# Face observations + free text hypothesis generation uses OrcaRouter's adaptive quality/cost router.
ORCAROUTER_HYPOTHESIS_MODEL=orcarouter/auto
ORCAROUTER_MODEL_LOW=qwen/qwen3.7-flash
ORCAROUTER_MODEL_MEDIUM=openai/gpt-5.6-luna
ORCAROUTER_MODEL_HIGH=openai/gpt-5.6-sol
ORCAROUTER_FALLBACK_MODELS=google/gemini-2.5-flash-lite,orcarouter/auto
ORCAROUTER_TIMEOUT_MS=20000
ORCAROUTER_FALLBACK_TIMEOUT_MS=45000
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# Optional: only needed when OpenFace is installed somewhere other than .runtime/openface-2.2.0.
# OPENFACE_FEATURE_EXTRACTION_PATH=C:\path\to\OpenFace\FeatureExtraction.exe

# Optional Streamable HTTP MCP endpoints. Leave blank when unavailable.
MCP_OPENFISCA_URL=http://127.0.0.1:8791/mcp
MCP_EGOV_URL=
MCP_LOCALGOV_URL=
MCP_ESTAT_URL=
MCP_WEB_URL=

# Optional stdio MCP commands. Args are JSON arrays.
# e-Gov is bundled and works without these values.
MCP_OPENFISCA_COMMAND=uvx
MCP_OPENFISCA_ARGS=["--python","3.11","openfisca-japan-mcp"]
MCP_EGOV_COMMAND=
MCP_EGOV_ARGS=[]
MCP_LOCALGOV_COMMAND=
MCP_LOCALGOV_ARGS=[]
MCP_ESTAT_COMMAND=
MCP_ESTAT_ARGS=[]
MCP_WEB_COMMAND=
MCP_WEB_ARGS=[]

# Optional. Required only when enabling e-Stat MCP.
ESTAT_APP_ID=
